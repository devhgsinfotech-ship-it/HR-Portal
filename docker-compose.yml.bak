version: "3.9"

services:
  mysql:
    image: mysql:8.0
    container_name: hr_portal_mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: root_password
      MYSQL_DATABASE: hr_portal
      MYSQL_USER: hr_user
      MYSQL_PASSWORD: hr_password
    ports:
      - "3306:3306"
    volumes:
      - ./mysql-data:/var/lib/mysql
      # Schema creation is on hold for now — no init script mounted.
      # When ready, either:
      #   a) uncomment the line below to auto-run db/init.sql on next fresh start, or
      #   b) run tables manually / via Prisma migrations later.
      # - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql
    networks:
      - hr_portal_network

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: hr_portal_phpmyadmin
    restart: unless-stopped
    environment:
      PMA_HOST: mysql
      PMA_USER: root
      PMA_PASSWORD: root_password
    ports:
      - "8080:80"
    depends_on:
      - mysql
    networks:
      - hr_portal_network

  backend:
    build: ./backend
    container_name: hr_portal_backend
    restart: unless-stopped
    env_file:
      - .env
    environment:
      DB_HOST: mysql
      DB_PORT: 3306
      DB_NAME: hr_portal
      DB_USER: hr_user
      DB_PASSWORD: hr_password
    ports:
      - "5000:5000"
    depends_on:
      - mysql
    volumes:
      - ./backend:/app
      - /app/node_modules
    networks:
      - hr_portal_network

  frontend:
    build: ./frontend
    container_name: hr_portal_frontend
    restart: unless-stopped
    ports:
      - "3000:80"
    depends_on:
      - backend
    networks:
      - hr_portal_network

networks:
  hr_portal_network:
    driver: bridge
