  CANCELLED
}

enum ReferralStatus {
  PENDING
  REVIEWED
  HIRED
  REJECTED
}

model SystemSetting {
  id                   Int      @id @default(autoincrement())
  systemName           String   @default("HR Portal")
  logoUrl              String?
  currency             String   @default("INR")
  currencySymbol       String   @default("₹")
  timezone             String   @default("Asia/Kolkata")
  language             String   @default("English")
  languageSwitcher     Boolean  @default(false)
  dateFormat           String   @default("DD/MM/YYYY")
  timeFormat           String   @default("12 Hours")
  financialYear        String   @default("2026-2027")
  startingMonth        String   @default("April")
  currencyPosition     String   @default("Front")
  decimalSeparator     String   @default(".")
  thousandSeparator    String   @default(",")
  countriesRestriction String   @default("Allow All Countries")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("system_settings")
}

model Currency {
  id             Int      @id @default(autoincrement())
  name           String
  code           String   @unique
  symbol         String
  symbolPosition String   @default("Front")
  exchangeRate   Float    @default(1.0)
  isDefault      Boolean  @default(false)
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("currencies")
}

model SeoSetting {
  id              Int       @id @default(autoincrement())
  companyId       Int?      @unique
  metaTitle       String?   @db.Text
  metaKeywords    String?   @db.Text
  metaDescription String?   @db.Text
  canonicalUrl    String?   @db.Text
  ogTitle         String?   @db.Text
  ogDescription   String?   @db.Text
  ogImage         String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("seo_settings")
}

model EmailTemplate {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  name           String
  category       String   @default("General")
  description    String?  @db.Text
  subject        String
  body           String   @db.Text
  tags           String   @db.Text
  defaultSubject String
  defaultBody    String   @db.Text
  isCustomized   Boolean  @default(false)
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("email_templates")
}

model CronJob {
  id            Int       @id @default(autoincrement())
  key           String    @unique
  name          String
  description   String?   @db.Text
  schedule      String
  scheduleHuman String
  status        String    @default("ACTIVE")
  lastRun       DateTime?
  nextRun       DateTime?
  lastStatus    String?
  lastMessage   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("cron_jobs")
}

model BannedIp {
  id          Int       @id @default(autoincrement())
  companyId   Int?
  ipAddress   String
  reason      String?   @db.Text
  status      String    @default("Active")
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([ipAddress])
  @@map("banned_ips")
}

model BackupRecord {
  id          Int       @id @default(autoincrement())
  companyId   Int?      // null = Full System / All Companies (Super Admin), otherwise specific company
  backupType  String    @default("COMPANY") // "COMPANY" or "SYSTEM_ALL"
  fileName    String
  fileSize    String
  filePath    String    @db.Text
  recordCount Int       @default(0)
  status      String    @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([backupType])
  @@map("backup_records")
}

// ==========================================
// Phase 1: Employee Lifecycle Models
// ==========================================

model Promotion {
  id                    Int          @id @default(autoincrement())
  companyId             Int
  employeeId            Int
  departmentId          Int?
  previousDesignationId Int?
  newDesignationId      Int
  promotionDate         DateTime
  previousSalary        Float?
  newSalary             Float?
  description           String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  company               Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department            Department?  @relation(fields: [departmentId], references: [id])
  previousDesignation   Designation? @relation("PrevDesignation", fields: [previousDesignationId], references: [id])
  newDesignation        Designation  @relation("NewDesignation", fields: [newDesignationId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([previousDesignationId])
  @@index([newDesignationId])
  @@map("promotions")
}

model Resignation {
  id              Int          @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  departmentId    Int?
  noticeDate      DateTime
  resignationDate DateTime
  reason          String?      @db.Text
  status          String       @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department      Department?  @relation(fields: [departmentId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([departmentId])
  @@map("resignations")
}

model Termination {
  id              Int          @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  departmentId    Int?
  terminationType String       // e.g. "Performance", "Misconduct", "Redundancy", "Other"
  noticeDate      DateTime
  terminationDate DateTime
  reason          String?      @db.Text
  status          String       @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    Int?
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department      Department?  @relation(fields: [departmentId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([departmentId])
  @@map("terminations")
}

// ========================================================
// PHASE 2: SHIFT SCHEDULING & WORK ARRANGEMENTS
// ========================================================

model ShiftSchedule {
  id            Int         @id @default(autoincrement())
  companyId     Int
  employeeId    Int
  shiftPolicyId Int
  startDate     DateTime    @db.Date
  endDate       DateTime?   @db.Date
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftPolicy   ShiftPolicy @relation(fields: [shiftPolicyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([shiftPolicyId])
  @@map("shift_schedules")
}

model ShiftSwapRequest {
  id               Int         @id @default(autoincrement())
  companyId        Int
  requesterId      Int
  targetEmployeeId Int?
  shiftDate        DateTime    @db.Date
  currentShiftId   Int
  requestedShiftId Int
  reason           String?     @db.Text
  status           String      @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById     Int?
  approvedAt       DateTime?
  rejectionReason  String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester        Employee    @relation("ShiftSwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetEmployee   Employee?   @relation("ShiftSwapTarget", fields: [targetEmployeeId], references: [id], onDelete: SetNull)
  currentShift     ShiftPolicy @relation("ShiftSwapCurrentShift", fields: [currentShiftId], references: [id], onDelete: Cascade)
  requestedShift   ShiftPolicy @relation("ShiftSwapRequestedShift", fields: [requestedShiftId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([requesterId])
  @@index([targetEmployeeId])
  @@index([currentShiftId])
  @@index([requestedShiftId])
  @@map("shift_swap_requests")
}

model OvertimeRecord {
  id           Int       @id @default(autoincrement())
  companyId    Int
  employeeId   Int
  overtimeDate DateTime  @db.Date
  hours        Decimal   @db.Decimal(5, 2)
  project      String?
  description  String?   @db.Text
  overtimeRate Decimal?  @db.Decimal(10, 2)
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById Int?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("overtime_records")
}

model WfhRequest {
  id           Int       @id @default(autoincrement())
  companyId    Int
  employeeId   Int
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  reason       String?   @db.Text
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById Int?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@map("wfh_requests")
}

// ========================================================
// PHASE 4: TRAINING & DEVELOPMENT MODELS
// ========================================================

model Trainer {
  id              Int               @id @default(autoincrement())
  companyId       Int
  firstName       String
  lastName        String
  email           String
  phone           String?
  role            String?           // e.g. "Senior Cloud Architect", "Soft Skills Lead"
  trainerType     String            @default("INTERNAL") // INTERNAL, EXTERNAL
  status          String            @default("ACTIVE") // ACTIVE, INACTIVE
  profilePhotoUrl String?
  description     String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingPrograms TrainingProgram[]

  @@index([companyId])
  @@map("trainers")
}

model TrainingType {
  id          Int               @id @default(autoincrement())
  companyId   Int
  type        String            // Name e.g. "Technical Skills", "Leadership", "Compliance"
  description String?           @db.Text
  status      String            @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingPrograms TrainingProgram[]

  @@unique([companyId, type])
  @@index([companyId])
  @@map("training_types")
}

model TrainingProgram {
  id              Int                   @id @default(autoincrement())
  companyId       Int
  trainingTypeId  Int
  trainerId       Int?
  title           String                // Program title
  description     String?               @db.Text
  startDate       DateTime?             @db.Date
  endDate         DateTime?             @db.Date
  cost            Decimal?              @db.Decimal(10, 2)
  status          String                @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingType    TrainingType          @relation(fields: [trainingTypeId], references: [id], onDelete: Cascade)
  trainer         Trainer?              @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  participants    TrainingParticipant[]

  @@index([companyId])
  @@index([trainingTypeId])
  @@index([trainerId])
  @@map("training_programs")
}

model TrainingParticipant {
  id                Int             @id @default(autoincrement())
  companyId         Int
  trainingProgramId Int
  employeeId        Int
  attendanceStatus  String          @default("ENROLLED") // ENROLLED, ATTENDED, COMPLETED, ABSENT
  feedback          String?         @db.Text
  rating            Float?
  certificateUrl    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingProgram   TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([trainingProgramId, employeeId])
  @@index([companyId])
  @@index([trainingProgramId])
  @@index([employeeId])
  @@map("training_participants")
}

// ========================================================
// PHASE 5: COMPANY POLICIES & GOVERNANCE
// ========================================================

model CompanyPolicy {
  id           Int         @id @default(autoincrement())
  companyId    Int
  departmentId Int?        // null = All Departments
  title        String
  description  String?     @db.Text
  policyDate   DateTime?   @db.Date
  documentUrl  String?     @db.Text
  status       String      @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([departmentId])
  @@map("company_policies")
}

