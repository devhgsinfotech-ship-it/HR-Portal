// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  HR
  EMPLOYEE
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TabName {
  SALARY
  PAYSLIPS
  LEAVES
  PROFILE
}

// ============================================================
// USERS — login accounts for both HR and Employees
// ============================================================
model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  password      String
  role          Role          @default(EMPLOYEE)
  accountStatus AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee              Employee?
  salaryStructuresMade  SalaryStructure[]   @relation("SalaryCreatedBy")
  payslipsGenerated     Payslip[]           @relation("PayslipGeneratedBy")
  leavesApproved        LeaveRequest[]      @relation("LeaveApprovedBy")
  tabAccessUpdates      EmployeeTabAccess[] @relation("TabAccessUpdatedBy")
  holidaysCreated       Holiday[]           @relation("HolidayCreatedBy")

  @@map("users")
}

// ============================================================
// EMPLOYEES — profile data, linked 1:1 to a user account
// ============================================================
model Employee {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode     String    @unique
  fullName         String
  designation      String?
  department       String?
  phone            String?
  address          String?
  dateOfBirth      DateTime?
  dateOfJoining    DateTime?
  profilePhotoUrl  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  salaryStructures SalaryStructure[]
  payslips         Payslip[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  tabAccess        EmployeeTabAccess[]
  inviteTokens     InviteToken[]

  @@map("employees")
}

// ============================================================
// SALARY STRUCTURE — breakup per employee
// ============================================================
model SalaryStructure {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic             Decimal  @default(0) @db.Decimal(12, 2)
  hra               Decimal  @default(0) @db.Decimal(12, 2)
  conveyance        Decimal  @default(0) @db.Decimal(12, 2)
  medicalAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  specialAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction       Decimal  @default(0) @db.Decimal(12, 2)
  professionalTax   Decimal  @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary       Decimal  @default(0) @db.Decimal(12, 2)
  netSalary         Decimal  @default(0) @db.Decimal(12, 2)
  effectiveFrom     DateTime
  createdById       Int?
  createdBy         User?    @relation("SalaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())

  @@map("salary_structures")
}

// ============================================================
// PAYSLIPS — monthly generated salary receipts
// ============================================================
model Payslip {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  filePath      String
  netPay        Decimal  @db.Decimal(12, 2)
  generatedById Int?
  generatedBy   User?    @relation("PayslipGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime @default(now())

  @@unique([employeeId, month, year])
  @@map("payslips")
}

// ============================================================
// LEAVE REQUESTS
// ============================================================
model LeaveRequest {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  approvedById Int?
  approvedBy   User?       @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("leave_requests")
}

// ============================================================
// LEAVE BALANCE — yearly quota tracking per employee
// ============================================================
model LeaveBalance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType
  year       Int
  totalDays  Decimal   @default(0) @db.Decimal(5, 1)
  usedDays   Decimal   @default(0) @db.Decimal(5, 1)

  @@unique([employeeId, leaveType, year])
  @@map("leave_balances")
}

// ============================================================
// EMPLOYEE TAB ACCESS — per-employee, per-tab permission control
// ============================================================
model EmployeeTabAccess {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tabName     TabName
  isEnabled   Boolean  @default(false)
  updatedById Int?
  updatedBy   User?    @relation("TabAccessUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, tabName])
  @@map("employee_tab_access")
}

// ============================================================
// HOLIDAYS — company-wide calendar
// ============================================================
model Holiday {
  id          Int      @id @default(autoincrement())
  title       String
  holidayDate DateTime
  description String?
  createdById Int?
  createdBy   User?    @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@map("holidays")
}

// ============================================================
// INVITE TOKENS — signup link issued when HR grants access
// ============================================================
model InviteToken {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("invite_tokens")
}
