// backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum OnboardingStatus {
  INVITED
  PROFILE_SUBMITTED
  DOCS_SUBMITTED
  HR_REVIEW
  CORRECTION_REQUESTED
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  MISSING_PUNCH
  IRREGULAR
  FLAGGED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  LEAVE_APPROVAL
  LEAVE_REJECTION
  PAYSLIP_GENERATED
  BIRTHDAY_REMINDER
  ATTENDANCE_REMINDER
  HOLIDAY_REMINDER
  ANNOUNCEMENT
  ASSET_ASSIGNED
  DOCUMENT_VERIFIED
}

// ============================================================
// COMPANY — each registered company's workspace
// ============================================================

model Company {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  phone           String?
  subdomain       String    @unique  // ← ADD THIS LINE e.g. "techcorp"
  emailDomain     String?   // The corporate email domain (e.g. hgsinfotech.com)
  industry        String?
  companySize     String?
  address         String?
  logoUrl         String?
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users           User[]
  departments     Department[]
  designations    Designation[]
  leaveTypes      LeaveType[]
  holidays        Holiday[]
  assets          Asset[]
  attendancePolicy AttendancePolicy?
  assetCategories AssetCategory[]
  settings        CompanySetting?
  announcements   Announcement[]
  shiftPolicies   ShiftPolicy[]
  leavePolicies   LeavePolicy[]
  @@map("companies")
}

// ============================================================
// USERS — login accounts for all roles
// ============================================================

model User {
  id            Int           @id @default(autoincrement())
  companyId     Int?
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  email         String        @unique
  password      String
  role          Role          @default(EMPLOYEE)
  accountStatus AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee              Employee?
  inviteTokens          InviteToken[]
  emailVerifyTokens     EmailVerifyToken[]
  notificationsReceived Notification[]     @relation("NotificationReceiver")
  notificationsSent     Notification[]     @relation("NotificationSender")
  regularizations       AttendanceRegularization[] // Requests reviewed by this user

  @@map("users")
}

// ============================================================
// EMPLOYEES — profile data, linked 1:1 to a user account
// ============================================================

model Employee {
  id                  Int             @id @default(autoincrement())
  userId              Int             @unique
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode        String          @unique
  firstName           String
  lastName            String
  gender              Gender?
  dateOfBirth         DateTime?
  phone               String?
  address             String?
  country             String?
  state               String?
  city                String?
  postalCode          String?
  profilePhotoUrl     String?
  dateOfJoining       DateTime?
  employmentType      EmploymentType  @default(FULL_TIME)
  departmentId        Int?
  department          Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId       Int?
  designation         Designation?    @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManagerId  Int?
  reportingManager    Employee?       @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates        Employee[]      @relation("ManagerSubordinates")
  emergencyContactName  String?
  emergencyContactPhone String?
  onboardingStatus    OnboardingStatus @default(INVITED)
  rejectionReason     String?
  shiftPolicyId       Int?
  shiftPolicy         ShiftPolicy?    @relation(fields: [shiftPolicyId], references: [id], onDelete: SetNull)
  leavePolicyId       Int?
  leavePolicy         LeavePolicy?    @relation(fields: [leavePolicyId], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  aadhaarPath         String?
  panPath             String?
  resumePath          String?

  // Profile & Bio
  about               String?   @db.Text
  education           String?   @db.Text
  experience          String?   @db.Text

  // Personal Information
  passportNo          String?
  passportExpiry      DateTime?
  nationality         String?
  religion            String?
  maritalStatus       String?
  spouseEmployed      String?
  spouseName          String?
  numberOfChildren    Int?

  // Emergency Contact
  emergencyContactRelationship  String?

  bankDetails         BankDetails?

  salaryStructure     SalaryStructure?
  payslips            Payslip[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  attendanceRecords   AttendanceRecord[]
  documents           Document[]
  assetAssignments    AssetAssignment[]
  inviteTokens        InviteToken[]
  performanceGoals    PerformanceGoal[]    @relation("EmployeeGoals")
  goalsCreated        PerformanceGoal[]    @relation("ManagerGoals")
  performanceReviews  PerformanceReview[]  @relation("EmployeeReviews")
  reviewsConducted    PerformanceReview[]  @relation("ManagerReviews")

  @@map("employees")
}

// ============================================================
// DEPARTMENTS
// ============================================================

model Department {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  headId      Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees   Employee[]

  @@unique([companyId, name])
  @@map("departments")
}

// ============================================================
// DESIGNATIONS
// ============================================================

model Designation {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())

  employees   Employee[]

  @@unique([companyId, name])
  @@map("designations")
}

// ============================================================
// LEAVE TYPES — configurable per company
// ============================================================

model LeaveType {
  id           Int       @id @default(autoincrement())
  companyId    Int
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  totalDaysPerYear Decimal @default(0) @db.Decimal(5, 1)
  isPaid       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([companyId, name])
  @@map("leave_types")
}

// ============================================================
// LEAVE REQUESTS
// ============================================================

model LeaveRequest {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  Int
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  totalDays    Decimal     @default(1) @db.Decimal(5, 1)
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  remarks      String?
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("leave_requests")
}

// ============================================================
// LEAVE BALANCES
// ============================================================

model LeaveBalance {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  Int
  leaveType    LeaveType @relation(fields: [leaveTypeId], references: [id])
  year         Int
  totalDays    Decimal   @default(0) @db.Decimal(5, 1)
  usedDays     Decimal   @default(0) @db.Decimal(5, 1)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// ============================================================
// ATTENDANCE RECORDS & POLICIES
// ============================================================

model AttendancePolicy {
  id                     Int      @id @default(autoincrement())
  companyId              Int      @unique
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  minimumHoursForHalfDay Decimal  @default(4.0) @db.Decimal(5, 2)
  minimumHoursForFullDay Decimal  @default(8.0) @db.Decimal(5, 2)
  allowWebPunch          Boolean  @default(true)
  requireGeofence        Boolean  @default(false)
  lateGracePeriod        Int      @default(15)
  autoCheckoutTime       String   @default("18:00") // HH:MM in IST, used for on-login detection
  updatedAt              DateTime @updatedAt

  @@map("attendance_policies")
}

model AttendanceRecord {
  id             Int              @id @default(autoincrement())
  employeeId     Int
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  breakIn        DateTime?
  breakOut       DateTime?
  workingHours   Decimal?         @db.Decimal(5, 2)
  status         AttendanceStatus @default(PRESENT)
  punchLocation  String?
  deviceType     String?          @default("WEB") // WEB, MOBILE, BIOMETRIC
  notes          String?
  createdAt      DateTime         @default(now())
  
  regularizations AttendanceRegularization[]

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model AttendanceRegularization {
  id                 Int              @id @default(autoincrement())
  attendanceRecordId Int
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedCheckIn   DateTime?
  requestedBreakOut  DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             LeaveStatus      @default(PENDING) // Reusing PENDING, APPROVED, REJECTED
  reviewedById       Int?
  reviewedBy         User?            @relation(fields: [reviewedById], references: [id])
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("attendance_regularizations")
}

// ============================================================
// SALARY STRUCTURE
// ============================================================

model SalaryStructure {
  id                Int      @id @default(autoincrement())
  employeeId        Int      @unique
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic             Decimal  @default(0) @db.Decimal(12, 2)
  hra               Decimal  @default(0) @db.Decimal(12, 2)
  conveyance        Decimal  @default(0) @db.Decimal(12, 2)
  medicalAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  specialAllowance  Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction       Decimal  @default(0) @db.Decimal(12, 2)
  professionalTax   Decimal  @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary       Decimal  @default(0) @db.Decimal(12, 2)
  netSalary         Decimal  @default(0) @db.Decimal(12, 2)
  effectiveFrom     DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("salary_structures")
}

// ============================================================
// PAYSLIPS
// ============================================================

model Payslip {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  basic         Decimal  @default(0) @db.Decimal(12, 2)
  totalAllowances Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal @default(0) @db.Decimal(12, 2)
  netPay        Decimal  @db.Decimal(12, 2)
  filePath      String?
  generatedAt   DateTime @default(now())

  @@unique([employeeId, month, year])
  @@map("payslips")
}

// ============================================================
// HOLIDAYS
// ============================================================

model Holiday {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  holidayDate DateTime @db.Date
  description String?
  isNational  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("holidays")
}

// ============================================================
// ASSET CATEGORIES
// ============================================================

model AssetCategory {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String

  assets    Asset[]

  @@map("asset_categories")
}

// ============================================================
// ASSETS
// ============================================================

model Asset {
  id          Int         @id @default(autoincrement())
  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId  Int?
  category    AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  assetCode   String      @unique
  status      AssetStatus @default(AVAILABLE)
  purchaseDate DateTime?
  description String?
  createdAt   DateTime    @default(now())

  assignments AssetAssignment[]

  @@map("assets")
}

// ============================================================
// ASSET ASSIGNMENTS
// ============================================================

model AssetAssignment {
  id           Int       @id @default(autoincrement())
  assetId      Int
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now())
  returnedAt   DateTime?
  notes        String?

  @@map("asset_assignments")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id          Int            @id @default(autoincrement())
  employeeId  Int
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  fileUrl     String
  fileType    String?
  status      DocumentStatus @default(PENDING)
  verifiedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@map("documents")
}

// ============================================================
// PERFORMANCE GOALS
// ============================================================

model PerformanceGoal {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById  Int
  createdBy    Employee @relation("ManagerGoals", fields: [createdById], references: [id], onDelete: Cascade)
  title        String
  description  String?
  targetDate   DateTime?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("performance_goals")
}

// ============================================================
// PERFORMANCE REVIEWS
// ============================================================

model PerformanceReview {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  employee     Employee @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   Int
  reviewer     Employee @relation("ManagerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  rating       Int      // 1 to 5
  feedback     String?
  reviewDate   DateTime @default(now())

  @@map("performance_reviews")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          Int              @id @default(autoincrement())
  receiverId  Int
  receiver    User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  senderId    Int?
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@map("notifications")
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

model Announcement {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  @@map("announcements")
}

// ============================================================
// COMPANY SETTINGS
// ============================================================

model CompanySetting {
  id              Int     @id @default(autoincrement())
  companyId       Int     @unique
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workingDays     String  @default("Mon,Tue,Wed,Thu,Fri")
  officeStartTime String  @default("09:00")
  officeEndTime   String  @default("18:00")
  timezone        String  @default("Asia/Kolkata")
  currency        String  @default("INR")

  @@map("company_settings")
}

// ============================================================
// INVITE TOKENS — for employee onboarding
// ============================================================

model InviteToken {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("invite_tokens")
}

// ============================================================
// EMAIL VERIFY TOKENS — for company registration
// ============================================================

model EmailVerifyToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verify_tokens")
}

// ============================================================
// ONBOARDING & POLICIES
// ============================================================

model BankDetails {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accountName   String
  accountNumber String
  bankName      String
  ifscCode      String
  branchName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_details")
}

model ShiftPolicy {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  startTime   String   // e.g. "09:00:00"
  endTime     String   // e.g. "18:00:00"
  gracePeriod Int      @default(15) // Minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   Employee[]

  @@map("shift_policies")
}

model LeavePolicy {
  id             Int      @id @default(autoincrement())
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  casualLeaves   Int      @default(0)
  sickLeaves     Int      @default(0)
  earnedLeaves   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employees      Employee[]

  @@map("leave_policies")
}

