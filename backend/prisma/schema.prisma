generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  phone            String?
  subdomain        String            @unique
  industry         String?
  companySize      String?
  address          String?
  logoUrl          String?
  iconUrl          String?
  isEmailVerified  Boolean           @default(false)
  isActive         Boolean           @default(true)
  domainStatus     String            @default("APPROVED")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  emailDomain      String?
  companyCode      String?           @unique
  announcements    Announcement[]
  applicants       Applicant[]
  assetCategories  AssetCategory[]
  assets           Asset[]
  attendancePolicy AttendancePolicy?
  clients          Client[]
  companyRoles     CompanyRole[]
  settings         CompanySetting?
  departments      Department[]
  designations     Designation[]
  holidays         Holiday[]
  invoices         Invoice[]
  jobPostings      JobPosting[]
  leavePolicies    LeavePolicy[]
  leaveTypes       LeaveType[]
  payrollPeriods   PayrollPeriod[]
  posts            Post[]
  projects         Project[]
  referrals        Referral[]
  shiftPolicies    ShiftPolicy[]
  subscription     Subscription?
  tasks            Task[]
  timeLogs         TimeLog[]
  users            User[]
  seoSetting       SeoSetting?
  bannedIps        BannedIp[]
  backupRecords    BackupRecord[]
  promotions       Promotion[]
  resignations     Resignation[]
  terminations     Termination[]
  shiftSchedules   ShiftSchedule[]
  shiftSwapRequests ShiftSwapRequest[]
  overtimeRecords  OvertimeRecord[]
  wfhRequests      WfhRequest[]
  goalTypes        GoalType[]
  performanceGoals PerformanceGoal[]
  performanceIndicators PerformanceIndicator[]
  performanceAppraisals PerformanceAppraisal[]
  performanceReviews    PerformanceReview[]
  trainers              Trainer[]
  trainingTypes         TrainingType[]
  trainingPrograms      TrainingProgram[]
  trainingParticipants  TrainingParticipant[]
  companyPolicies       CompanyPolicy[]

  @@map("companies")
}

model SubscriptionPlan {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  description   String?        @db.Text
  priceMonthly  Float
  priceYearly   Float
  basePriceMonthly Float?
  basePriceYearly  Float?
  maxEmployees  Int            @default(10)
  maxStorageGb  Float          @default(5)
  features      Json?
  currency      String         @default("INR")
  currencySymbol String        @default("₹")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id           Int                @id @default(autoincrement())
  companyId    Int                @unique
  planId       Int
  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  trialEndsAt  DateTime
  autoRenew    Boolean            @default(true)
  customFeatures Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  invoices     Invoice[]
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  companyId      Int
  subscriptionId Int?
  invoiceNumber  String        @unique
  amount         Float
  currency       String        @default("INR")
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime
  paidAt         DateTime?
  paymentMethod  String?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId], map: "invoices_companyId_fkey")
  @@index([subscriptionId], map: "invoices_subscriptionId_fkey")
  @@map("invoices")
}

model User {
  id                    Int                        @id @default(autoincrement())
  companyId             Int?
  name                  String
  email                 String                     @unique
  password              String
  role                  Role                       @default(EMPLOYEE)
  accountStatus         AccountStatus              @default(PENDING)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  regularizations       AttendanceRegularization[]
  emailVerifyTokens     EmailVerifyToken[]
  employee              Employee?
  inviteTokens          InviteToken[]
  notificationsReceived Notification[]             @relation("NotificationReceiver")
  notificationsSent     Notification[]             @relation("NotificationSender")
  passwordResetTokens   PasswordResetToken[]
  referrals             Referral[]                 @relation("ReferrerUser")
  TaskComment           TaskComment[]
  tasksCreated          Task[]                     @relation("TaskCreator")
  company               Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "users_companyId_fkey")
  @@map("users")
}

model Employee {
  id                           Int                 @id @default(autoincrement())
  userId                       Int                 @unique
  employeeCode                 String              @unique
  firstName                    String
  lastName                     String
  gender                       Gender?
  dateOfBirth                  DateTime?
  phone                        String?
  address                      String?
  profilePhotoUrl              String?
  dateOfJoining                DateTime?
  employmentType               EmploymentType      @default(FULL_TIME)
  departmentId                 Int?
  designationId                Int?
  reportingManagerId           Int?
  emergencyContactName         String?
  emergencyContactPhone        String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  city                         String?
  country                      String?
  postalCode                   String?
  state                        String?
  onboardingStatus             OnboardingStatus    @default(INVITED)
  shiftPolicyId                Int?
  aadhaarPath                  String?
  panPath                      String?
  resumePath                   String?
  rejectionReason              String?
  about                        String?             @db.Text
  education                    String?             @db.Text
  emergencyContactRelationship String?
  experience                   String?             @db.Text
  maritalStatus                String?
  nationality                  String?
  numberOfChildren             Int?
  passportExpiry               DateTime?
  passportNo                   String?
  religion                     String?
  spouseEmployed               String?
  spouseName                   String?
  companyRoleId                Int?

  // Lifecycle Management Fields (Phase 1)
  probationDurationMonths      Int?                @default(3)
  probationEndDate             DateTime?
  probationStatus              String?             @default("ON_PROBATION") // ON_PROBATION, CONFIRMED, EXTENDED, FAILED
  noticePeriodDays             Int?                @default(30)
  noticeStartDate              DateTime?
  noticeEndDate                DateTime?
  noticeStatus                 String?             // SERVING, COMPLETED, WAIVED
  exitDate                     DateTime?
  exitType                     String?             // RESIGNATION, TERMINATION, RETIREMENT

  announcementsCreated         Announcement[]      @relation("AnnouncementsCreated")
  assetAssignments             AssetAssignment[]
  attendanceRecords            AttendanceRecord[]
  bankDetails                  BankDetails?
  commentLikes                 CommentLike[]
  documents                    Document[]
  companyRole                  CompanyRole?        @relation(fields: [companyRoleId], references: [id])
  department                   Department?         @relation(fields: [departmentId], references: [id])
  designation                  Designation?        @relation(fields: [designationId], references: [id])
  reportingManager             Employee?           @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates                 Employee[]          @relation("ManagerSubordinates")
  shiftPolicy                  ShiftPolicy?        @relation(fields: [shiftPolicyId], references: [id])
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews                   Interview[]         @relation("Interviewer")
  inviteTokens                 InviteToken[]
  leaveBalances                LeaveBalance[]
  leaveRequests                LeaveRequest[]
  payrollEntries               PayrollEntry[]
  payslips                     Payslip[]
  goalsCreated                 PerformanceGoal[]   @relation("ManagerGoals")
  performanceGoals             PerformanceGoal[]   @relation("EmployeeGoals")
  performanceReviews           PerformanceReview[] @relation("EmployeeReviews")
  reviewsConducted             PerformanceReview[] @relation("ManagerReviews")
  postComments                 PostComment[]
  postLikes                    PostLike[]
  posts                        Post[]
  uploadedFiles                ProjectFile[]       @relation("FileUploader")
  projectMemberships           ProjectMember[]
  createdNotes                 ProjectNote[]       @relation("NoteCreator")
  companyManagedProjects       Project[]           @relation("ProjectCompanyManager")
  managedProjects              Project[]           @relation("ProjectManager")
  salaryStructure              SalaryStructure?
  tasksAssigned                Task[]              @relation("TaskAssignee")
  timeLogs                     TimeLog[]
  leavePolicies                LeavePolicy[]       @relation("EmployeeToLeavePolicy")
  promotions                   Promotion[]
  resignations                 Resignation[]
  terminations                 Termination[]
  shiftSchedules               ShiftSchedule[]
  shiftSwapRequestsSent        ShiftSwapRequest[]  @relation("ShiftSwapRequester")
  shiftSwapRequestsReceived    ShiftSwapRequest[]  @relation("ShiftSwapTarget")
  overtimeRecords              OvertimeRecord[]
  wfhRequests                  WfhRequest[]
  performanceIndicators        PerformanceIndicator[] @relation("IndicatorAddedBy")
  appraisalsReceived           PerformanceAppraisal[] @relation("AppraisalEmployee")
  appraisalsConducted          PerformanceAppraisal[] @relation("AppraisalReviewer")
  trainingParticipations       TrainingParticipant[]


  @@index([companyRoleId], map: "employees_companyRoleId_fkey")
  @@index([departmentId], map: "employees_departmentId_fkey")
  @@index([designationId], map: "employees_designationId_fkey")
  @@index([reportingManagerId], map: "employees_reportingManagerId_fkey")
  @@index([shiftPolicyId], map: "employees_shiftPolicyId_fkey")
  @@map("employees")
}

model Department {
  id           Int           @id @default(autoincrement())
  companyId    Int
  name         String
  description  String?
  headId       Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees    Employee[]
  jobPostings  JobPosting[]
  promotions   Promotion[]
  resignations Resignation[]
  terminations Termination[]
  performanceIndicators PerformanceIndicator[]
  companyPolicies       CompanyPolicy[]

  @@unique([companyId, name])
  @@map("departments")
}

model Designation {
  id             Int         @id @default(autoincrement())
  companyId      Int
  name           String
  description    String?
  createdAt      DateTime    @default(now())
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees      Employee[]
  promotionsFrom Promotion[] @relation("PrevDesignation")
  promotionsTo   Promotion[] @relation("NewDesignation")
  performanceIndicators PerformanceIndicator[]

  @@unique([companyId, name])
  @@map("designations")
}

model LeaveType {
  id               Int            @id @default(autoincrement())
  companyId        Int
  name             String
  totalDaysPerYear Decimal        @default(0.0) @db.Decimal(5, 1)
  isPaid           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  leaveBalances    LeaveBalance[]
  leavePolicies    LeavePolicy[]
  leaveRequests    LeaveRequest[]
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("leave_types")
}

model LeaveRequest {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  leaveTypeId  Int
  startDate    DateTime
  endDate      DateTime
  totalDays    Decimal      @default(1.0) @db.Decimal(5, 1)
  reason       String?
  status       LeaveStatus  @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  remarks      String?
  appliedAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  leaveSession LeaveSession @default(FULL_DAY)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "leave_requests_employeeId_fkey")
  @@index([leaveTypeId], map: "leave_requests_leaveTypeId_fkey")
  @@map("leave_requests")
}

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int
  totalDays   Decimal   @default(0.0) @db.Decimal(5, 1)
  usedDays    Decimal   @default(0.0) @db.Decimal(5, 1)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([leaveTypeId], map: "leave_balances_leaveTypeId_fkey")
  @@map("leave_balances")
}

model AttendancePolicy {
  id                     Int      @id @default(autoincrement())
  companyId              Int      @unique
  minimumHoursForHalfDay Decimal  @default(4.00) @db.Decimal(5, 2)
  minimumHoursForFullDay Decimal  @default(8.00) @db.Decimal(5, 2)
  allowWebPunch          Boolean  @default(true)
  requireGeofence        Boolean  @default(false)
  updatedAt              DateTime @updatedAt
  lateGracePeriod        Int      @default(15)
  autoCheckoutTime       String   @default("18:00")
  weekOffDays            String   @default("Saturday,Sunday")
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("attendance_policies")
}

model AttendanceRecord {
  id              Int                        @id @default(autoincrement())
  employeeId      Int
  date            DateTime                   @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  breakIn         DateTime?
  breakOut        DateTime?
  workingHours    Decimal?                   @db.Decimal(5, 2)
  status          AttendanceStatus           @default(PRESENT)
  notes           String?
  createdAt       DateTime                   @default(now())
  deviceType      String?                    @default("WEB")
  punchLocation   String?
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  regularizations AttendanceRegularization[]

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model AttendanceRegularization {
  id                 Int              @id @default(autoincrement())
  attendanceRecordId Int
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             LeaveStatus      @default(PENDING)
  reviewedById       Int?
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  requestedBreakOut  DateTime?
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  reviewedBy         User?            @relation(fields: [reviewedById], references: [id])

  @@index([attendanceRecordId], map: "attendance_regularizations_attendanceRecordId_fkey")
  @@index([reviewedById], map: "attendance_regularizations_reviewedById_fkey")
  @@map("attendance_regularizations")
}

model SalaryStructure {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @unique
  basic            Decimal  @default(0.00) @db.Decimal(12, 2)
  hra              Decimal  @default(0.00) @db.Decimal(12, 2)
  conveyance       Decimal  @default(0.00) @db.Decimal(12, 2)
  medicalAllowance Decimal  @default(0.00) @db.Decimal(12, 2)
  specialAllowance Decimal  @default(0.00) @db.Decimal(12, 2)
  pfDeduction      Decimal  @default(0.00) @db.Decimal(12, 2)
  professionalTax  Decimal  @default(0.00) @db.Decimal(12, 2)
  otherDeductions  Decimal  @default(0.00) @db.Decimal(12, 2)
  grossSalary      Decimal  @default(0.00) @db.Decimal(12, 2)
  netSalary        Decimal  @default(0.00) @db.Decimal(12, 2)
  effectiveFrom    DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bonus            Decimal  @default(0.00) @db.Decimal(12, 2)
  pfEmployer       Decimal  @default(0.00) @db.Decimal(12, 2)
  tdsDeduction     Decimal  @default(0.00) @db.Decimal(12, 2)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model Payslip {
  id              Int           @id @default(autoincrement())
  employeeId      Int
  month           Int
  year            Int
  basic           Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAllowances Decimal       @default(0.00) @db.Decimal(12, 2)
  totalDeductions Decimal       @default(0.00) @db.Decimal(12, 2)
  netPay          Decimal       @db.Decimal(12, 2)
  filePath        String?
  generatedAt     DateTime      @default(now())
  payrollEntryId  Int?          @unique
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollEntry    PayrollEntry? @relation(fields: [payrollEntryId], references: [id])

  @@unique([employeeId, month, year])
  @@map("payslips")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  companyId   Int
  title       String
  holidayDate DateTime @db.Date
  description String?
  isNational  Boolean  @default(false)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "holidays_companyId_fkey")
  @@map("holidays")
}

model AssetCategory {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets    Asset[]

  @@index([companyId], map: "asset_categories_companyId_fkey")
  @@map("asset_categories")
}

model Asset {
  id           Int               @id @default(autoincrement())
  companyId    Int
  categoryId   Int?
  name         String
  assetCode    String            @unique
  status       AssetStatus       @default(AVAILABLE)
  purchaseDate DateTime?
  description  String?
  createdAt    DateTime          @default(now())
  assignments  AssetAssignment[]
  category     AssetCategory?    @relation(fields: [categoryId], references: [id])
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "assets_categoryId_fkey")
  @@index([companyId], map: "assets_companyId_fkey")
  @@map("assets")
}

model AssetAssignment {
  id         Int       @id @default(autoincrement())
  assetId    Int
  employeeId Int
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId], map: "asset_assignments_assetId_fkey")
  @@index([employeeId], map: "asset_assignments_employeeId_fkey")
  @@map("asset_assignments")
}

model Document {
  id         Int            @id @default(autoincrement())
  employeeId Int
  name       String
  fileUrl    String
  fileType   String?
  status     DocumentStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime       @default(now())
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "documents_employeeId_fkey")
  @@map("documents")
}

model GoalType {
  id          Int               @id @default(autoincrement())
  companyId   Int
  name        String
  description String?           @db.Text
  status      String            @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goals       PerformanceGoal[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("goal_types")
}

model PerformanceGoal {
  id                Int       @id @default(autoincrement())
  companyId         Int
  employeeId        Int
  createdById       Int?
  goalTypeId        Int?
  subject           String    // Title of the goal
  targetAchievement String?   // Expected metric e.g. "15 Deals", "99.9% Uptime"
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  description       String?   @db.Text
  status            String    @default("ACTIVE") // ACTIVE, IN_PROGRESS, COMPLETED, ON_HOLD, OVERDUE
  progress          Int       @default(0) // 0 to 100 percentage
  isCompleted       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee          Employee  @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy         Employee? @relation("ManagerGoals", fields: [createdById], references: [id], onDelete: SetNull)
  goalType          GoalType? @relation(fields: [goalTypeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([createdById])
  @@index([goalTypeId])
  @@map("performance_goals")
}

model PerformanceIndicator {
  id                 Int          @id @default(autoincrement())
  companyId          Int
  departmentId       Int?
  designationId      Int?
  addedById          Int?
  customerExperience String       @default("Advanced") // None, Beginner, Intermediate, Advanced, Expert
  marketing          String       @default("Intermediate")
  management         String       @default("Advanced")
  administration     String       @default("Intermediate")
  presentationSkills String       @default("Advanced")
  qualityOfWork      String       @default("Advanced")
  efficiency         String       @default("Advanced")
  integrity          String       @default("Advanced")
  status             String       @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation        Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  addedBy            Employee?    @relation("IndicatorAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([departmentId])
  @@index([designationId])
  @@map("performance_indicators")
}

model PerformanceAppraisal {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  employeeId          Int
  reviewerId          Int?
  appraisalCycle      String    @default("Annual Review 2026")
  appraisalDate       DateTime  @db.Date
  selfRating          Float?    @default(0)
  managerRating       Float?    @default(0)
  finalRating         Float?    @default(0)
  competencyScore     Float?    @default(0)
  strengths           String?   @db.Text
  areasForImprovement String?   @db.Text
  employeeRemarks     String?   @db.Text
  managerRemarks      String?   @db.Text
  hrRemarks           String?   @db.Text
  status              String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee            Employee  @relation("AppraisalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer            Employee? @relation("AppraisalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_appraisals")
}

model PerformanceReview {
  id         Int       @id @default(autoincrement())
  companyId  Int?
  employeeId Int
  reviewerId Int
  rating     Int
  feedback   String?   @db.Text
  reviewDate DateTime  @default(now())

  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee  @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer   Employee  @relation("ManagerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_reviews")
}

model Notification {
  id         Int              @id @default(autoincrement())
  receiverId Int
  senderId   Int?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  receiver   User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?            @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([receiverId], map: "notifications_receiverId_fkey")
  @@index([senderId], map: "notifications_senderId_fkey")
  @@map("notifications")
}

model Announcement {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  title               String
  content             String    @db.Text
  createdAt           DateTime  @default(now())
  createdByEmployeeId Int?
  expiresAt           DateTime?
  imageUrl            String?
  publishedAt         DateTime  @default(now())
  targetDepartmentId  Int?
  targetType          String    @default("ALL")
  updatedAt           DateTime  @default(now()) @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
