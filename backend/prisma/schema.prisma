// backend/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum OnboardingStatus {
  INVITED
  PROFILE_SUBMITTED
  DOCS_SUBMITTED
  HR_REVIEW
  CORRECTION_REQUESTED
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveSession {
  FULL_DAY
  FIRST_HALF
  SECOND_HALF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  MISSING_PUNCH
  IRREGULAR
  FLAGGED
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  LEAVE_APPROVAL
  LEAVE_REJECTION
  PAYSLIP_GENERATED
  BIRTHDAY_REMINDER
  ATTENDANCE_REMINDER
  HOLIDAY_REMINDER
  ANNOUNCEMENT
  ASSET_ASSIGNED
  DOCUMENT_VERIFIED
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  ON_HOLD
}

enum ProjectPriority {
  HIGH
  MEDIUM
  LOW
}

enum ProjectHealth {
  GOOD
  AT_RISK
  CRITICAL
}

enum TaskStatus {
  TODO
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

// ============================================================
// COMPANY — each registered company's workspace
// ============================================================

model Company {
  id              Int       @id @default(autoincrement())
  name            String
  posts            Post[]
  email           String    @unique
  phone           String?
  subdomain       String    @unique
  emailDomain     String?
  industry        String?
  companySize     String?
  address         String?
  logoUrl         String?
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users            User[]
  departments      Department[]
  designations     Designation[]
  leaveTypes       LeaveType[]
  holidays         Holiday[]
  assets           Asset[]
  attendancePolicy AttendancePolicy?
  assetCategories  AssetCategory[]
  settings         CompanySetting?
  announcements    Announcement[]
  shiftPolicies    ShiftPolicy[]
  leavePolicies    LeavePolicy[]
  clients          Client[]
  projects         Project[]
  tasks            Task[]
  timeLogs         TimeLog[]
  companyRoles     CompanyRole[]

  @@map("companies")
}

// ============================================================
// USERS — login accounts for all roles
// ============================================================

model User {
  id            Int           @id @default(autoincrement())
  companyId     Int?
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  email         String        @unique
  password      String
  role          Role          @default(EMPLOYEE)
  accountStatus AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee              Employee?
  inviteTokens          InviteToken[]
  emailVerifyTokens     EmailVerifyToken[]
  notificationsReceived Notification[]     @relation("NotificationReceiver")
  notificationsSent     Notification[]     @relation("NotificationSender")
  regularizations       AttendanceRegularization[]
  passwordResetTokens   PasswordResetToken[]
  tasksCreated          Task[]             @relation("TaskCreator")

  @@map("users")
}

// ============================================================
// EMPLOYEES — profile data, linked 1:1 to a user account
// ============================================================

model Employee {
  id                  Int              @id @default(autoincrement())
  userId              Int              @unique
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode        String           @unique
  firstName           String
  lastName            String
  gender              Gender?
  dateOfBirth         DateTime?
  phone               String?
  address             String?
  country             String?
  state               String?
  city                String?
  postalCode          String?
  profilePhotoUrl     String?
  dateOfJoining       DateTime?
  employmentType      EmploymentType   @default(FULL_TIME)
  departmentId        Int?
  department          Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId       Int?
  designation         Designation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManagerId  Int?
  reportingManager    Employee?        @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates        Employee[]       @relation("ManagerSubordinates")
  emergencyContactName  String?
  emergencyContactPhone String?
  onboardingStatus    OnboardingStatus @default(INVITED)
  rejectionReason     String?
  shiftPolicyId       Int?
  shiftPolicy         ShiftPolicy?     @relation(fields: [shiftPolicyId], references: [id], onDelete: SetNull)
  leavePolicies       LeavePolicy[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  aadhaarPath         String?
  panPath             String?
  resumePath          String?

  // Profile & Bio
  about               String?   @db.Text
  education           String?   @db.Text
  experience          String?   @db.Text

  // Personal Information
  passportNo          String?
  passportExpiry      DateTime?
  nationality         String?
  religion            String?
  maritalStatus       String?
  spouseEmployed      String?
  spouseName          String?
  numberOfChildren    Int?

  // Emergency Contact
  emergencyContactRelationship  String?

  bankDetails         BankDetails?

  salaryStructure     SalaryStructure?
  payslips            Payslip[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  attendanceRecords   AttendanceRecord[]
  documents           Document[]
  assetAssignments    AssetAssignment[]
  inviteTokens        InviteToken[]
  performanceGoals    PerformanceGoal[]   @relation("EmployeeGoals")
  goalsCreated        PerformanceGoal[]   @relation("ManagerGoals")
  performanceReviews  PerformanceReview[] @relation("EmployeeReviews")
  reviewsConducted    PerformanceReview[] @relation("ManagerReviews")

  // PSA Relations
  companyRoleId       Int?
  companyRole         CompanyRole?        @relation(fields: [companyRoleId], references: [id], onDelete: SetNull)
  projectMemberships  ProjectMember[]
  tasksAssigned       Task[]              @relation("TaskAssignee")
  timeLogs            TimeLog[]
  managedProjects     Project[]           @relation("ProjectManager")
  createdNotes        ProjectNote[]       @relation("NoteCreator")
  uploadedFiles       ProjectFile[]       @relation("FileUploader")
  posts               Post[]
  postLikes           PostLike[]
  postComments        PostComment[]
  commentLikes        CommentLike[]
  announcementsCreated Announcement[] @relation("AnnouncementsCreated")

  @@map("employees")
}

// ============================================================
// DEPARTMENTS
// ============================================================

model Department {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  headId      Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees   Employee[]

  @@unique([companyId, name])
  @@map("departments")
}

// ============================================================
// DESIGNATIONS
// ============================================================

model Designation {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())

  employees   Employee[]

  @@unique([companyId, name])
  @@map("designations")
}

// ============================================================
// LEAVE TYPES — configurable per company
// ============================================================

model LeaveType {
  id               Int       @id @default(autoincrement())
  companyId        Int
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  totalDaysPerYear Decimal   @default(0) @db.Decimal(5, 1)
  isPaid           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
  leavePolicies LeavePolicy[]

  @@unique([companyId, name])
  @@map("leave_types")
}

// ============================================================
// LEAVE REQUESTS
// ============================================================

model LeaveRequest {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  Int
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime
  endDate      DateTime
  totalDays    Decimal       @default(1) @db.Decimal(5, 1)
  leaveSession LeaveSession  @default(FULL_DAY)
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  remarks      String?
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("leave_requests")
}

// ============================================================
// LEAVE BALANCES
// ============================================================

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Decimal   @default(0) @db.Decimal(5, 1)
  usedDays    Decimal   @default(0) @db.Decimal(5, 1)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// ============================================================
// ATTENDANCE RECORDS & POLICIES
// ============================================================

model AttendancePolicy {
  id                     Int      @id @default(autoincrement())
  companyId              Int      @unique
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  minimumHoursForHalfDay Decimal  @default(4.0) @db.Decimal(5, 2)
  minimumHoursForFullDay Decimal  @default(8.0) @db.Decimal(5, 2)
  allowWebPunch          Boolean  @default(true)
  requireGeofence        Boolean  @default(false)
  lateGracePeriod        Int      @default(15)
  autoCheckoutTime       String   @default("18:00")
  updatedAt              DateTime @updatedAt

  @@map("attendance_policies")
}

model AttendanceRecord {
  id             Int              @id @default(autoincrement())
  employeeId     Int
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  breakIn        DateTime?
  breakOut       DateTime?
  workingHours   Decimal?         @db.Decimal(5, 2)
  status         AttendanceStatus @default(PRESENT)
  punchLocation  String?
  deviceType     String?          @default("WEB")
  notes          String?
  createdAt      DateTime         @default(now())

  regularizations AttendanceRegularization[]

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model AttendanceRegularization {
  id                 Int              @id @default(autoincrement())
  attendanceRecordId Int
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedCheckIn   DateTime?
  requestedBreakOut  DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             LeaveStatus      @default(PENDING)
  reviewedById       Int?
  reviewedBy         User?            @relation(fields: [reviewedById], references: [id])
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("attendance_regularizations")
}

// ============================================================
// SALARY STRUCTURE
// ============================================================

model SalaryStructure {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @unique
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basic            Decimal  @default(0) @db.Decimal(12, 2)
  hra              Decimal  @default(0) @db.Decimal(12, 2)
  conveyance       Decimal  @default(0) @db.Decimal(12, 2)
  medicalAllowance Decimal  @default(0) @db.Decimal(12, 2)
  specialAllowance Decimal  @default(0) @db.Decimal(12, 2)
  pfDeduction      Decimal  @default(0) @db.Decimal(12, 2)
  professionalTax  Decimal  @default(0) @db.Decimal(12, 2)
  otherDeductions  Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary      Decimal  @default(0) @db.Decimal(12, 2)
  netSalary        Decimal  @default(0) @db.Decimal(12, 2)
  effectiveFrom    DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("salary_structures")
}

// ============================================================
// PAYSLIPS
// ============================================================

model Payslip {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  basic           Decimal  @default(0) @db.Decimal(12, 2)
  totalAllowances Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(12, 2)
  netPay          Decimal  @db.Decimal(12, 2)
  filePath        String?
  generatedAt     DateTime @default(now())

  @@unique([employeeId, month, year])
  @@map("payslips")
}

// ============================================================
// HOLIDAYS
// ============================================================

model Holiday {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  holidayDate DateTime @db.Date
  description String?
  isNational  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("holidays")
}

// ============================================================
// ASSET CATEGORIES
// ============================================================

model AssetCategory {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String

  assets    Asset[]

  @@map("asset_categories")
}

// ============================================================
// ASSETS
// ============================================================

model Asset {
  id           Int            @id @default(autoincrement())
  companyId    Int
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId   Int?
  category     AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name         String
  assetCode    String         @unique
  status       AssetStatus    @default(AVAILABLE)
  purchaseDate DateTime?
  description  String?
  createdAt    DateTime       @default(now())

  assignments AssetAssignment[]

  @@map("assets")
}

// ============================================================
// ASSET ASSIGNMENTS
// ============================================================

model AssetAssignment {
  id         Int       @id @default(autoincrement())
  assetId    Int
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?

  @@map("asset_assignments")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id         Int            @id @default(autoincrement())
  employeeId Int
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  fileType   String?
  status     DocumentStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@map("documents")
}

// ============================================================
// PERFORMANCE GOALS
// ============================================================

model PerformanceGoal {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById Int
  createdBy   Employee @relation("ManagerGoals", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  description String?
  targetDate  DateTime?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("performance_goals")
}

// ============================================================
// PERFORMANCE REVIEWS
// ============================================================

model PerformanceReview {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId Int
  reviewer   Employee @relation("ManagerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  rating     Int
  feedback   String?
  reviewDate DateTime @default(now())

  @@map("performance_reviews")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id         Int              @id @default(autoincrement())
  receiverId Int
  receiver   User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  senderId   Int?
  sender     User?            @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@map("notifications")
}

// ============================================================
// ANNOUNCEMENTS
// ============================================================

model Announcement {
  id                   Int         @id @default(autoincrement())
  companyId            Int
  company              Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByEmployeeId  Int?
  createdBy            Employee?   @relation("AnnouncementsCreated", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  title                String
  content              String      @db.Text
  imageUrl             String?
  targetType           String      @default("ALL")
  targetDepartmentId   Int?
  publishedAt          DateTime    @default(now())
  expiresAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@map("announcements")
}

// ============================================================
// COMPANY SETTINGS
// ============================================================

model CompanySetting {
  id              Int     @id @default(autoincrement())
  companyId       Int     @unique
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workingDays     String  @default("Mon,Tue,Wed,Thu,Fri")
  officeStartTime String  @default("09:00")
  officeEndTime   String  @default("18:00")
  timezone        String  @default("Asia/Kolkata")
  currency        String  @default("INR")

  @@map("company_settings")
}

// ============================================================
// INVITE TOKENS — for employee onboarding
// ============================================================

model InviteToken {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("invite_tokens")
}

// ============================================================
// EMAIL VERIFY TOKENS — for company registration
// ============================================================

model EmailVerifyToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verify_tokens")
}

// ============================================================
// BANK DETAILS & SHIFT POLICIES
// ============================================================

model BankDetails {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accountName   String
  accountNumber String
  bankName      String
  ifscCode      String
  branchName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("bank_details")
}

model ShiftPolicy {
  id          Int      @id @default(autoincrement())
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  startTime   String
  endTime     String
  gracePeriod Int      @default(15)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   Employee[]

  @@map("shift_policies")
}

model LeavePolicy {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveTypeId Int
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  days        Decimal   @db.Decimal(5, 1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees   Employee[]

  @@unique([companyId, leaveTypeId, name])
  @@map("leave_policies")
}

// ============================================================
// PASSWORD RESET TOKENS
// ============================================================

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// ============================================================
// KEKA PSA — CLIENTS
// ============================================================

model Client {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName   String
  contactPerson String?
  email         String
  phone         String?
  address       String?
  website       String?
  isActive      Boolean   @default(true)
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("clients")
}

// ============================================================
// KEKA PSA — PROJECTS
// ============================================================

model Project {
  id               Int                @id @default(autoincrement())
  companyId        Int
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectCode      String             @unique
  name             String
  description      String?            @db.Text
  clientId         Int?
  client           Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectManagerId Int?
  projectManager   Employee?          @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  startDate        DateTime
  endDate          DateTime
  budget           Float?
  actualCost       Float              @default(0.0)
  priority         ProjectPriority    @default(MEDIUM)
  status           ProjectStatus      @default(ACTIVE)
  healthStatus     ProjectHealth      @default(GOOD)
  attachmentUrl    String?
  logoUrl          String?
  members          ProjectMember[]
  milestones       ProjectMilestone[]
  tasks            Task[]
  timeLogs         TimeLog[]
  notes            ProjectNote[]
  files            ProjectFile[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("projects")
}

// ============================================================
// KEKA PSA — PROJECT MEMBERS (Resource Allocation)
// ============================================================

model ProjectMember {
  id                   Int      @id @default(autoincrement())
  projectId            Int
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId           Int
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role                 String?
  allocationPercentage Float    @default(100.0)
  createdAt            DateTime @default(now())

  @@unique([projectId, employeeId])
  @@map("project_members")
}

// ============================================================
// KEKA PSA — PROJECT MILESTONES (Phases)
// ============================================================

model ProjectMilestone {
  id                   Int      @id @default(autoincrement())
  projectId            Int
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  description          String?  @db.Text
  startDate            DateTime @default(now())
  dueDate              DateTime
  completionPercentage Float    @default(0.0)
  status               String   @default("PENDING")
  tasks                Task[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("project_milestones")
}

// ============================================================
// KEKA PSA — PROJECT NOTES
// ============================================================

model ProjectNote {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     String    @db.Text
  createdById Int?
  createdBy   Employee? @relation("NoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("project_notes")
}

// ============================================================
// KEKA PSA — PROJECT FILES & IMAGES
// ============================================================

model ProjectFile {
  id          Int       @id @default(autoincrement())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  url         String
  fileType    String    @default("file") // "image" | "file"
  mimeType    String?
  sizeBytes   Int?
  uploadedById Int?
  uploadedBy  Employee? @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@map("project_files")
}

// ============================================================
// KEKA PSA — TASKS
// ============================================================

model Task {
  id             Int               @id @default(autoincrement())
  companyId      Int
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskCode       String            @unique
  title          String
  description    String?           @db.Text
  projectId      Int
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId    Int?
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignedToId   Int?
  assignedTo     Employee?         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById    Int?
  createdBy      User?             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  priority       ProjectPriority   @default(MEDIUM)
  status         TaskStatus        @default(TODO)
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float             @default(0.0)
  actualHours    Float             @default(0.0)
  dependsOnTaskId Int?
  sortOrder      Int               @default(0)
  subTasks       SubTask[]
  timeLogs       TimeLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("tasks")
}

// ============================================================
// KEKA PSA — SUB-TASKS (Checklist Items)
// ============================================================

model SubTask {
  id          Int      @id @default(autoincrement())
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("sub_tasks")
}

// ============================================================
// KEKA PSA — TIME LOGS (Employee Timesheets)
// ============================================================

model TimeLog {
  id             Int      @id @default(autoincrement())
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId     Int
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId         Int?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  logDate        DateTime
  hoursSpent     Float
  billableHours  Float    @default(0.0)
  description    String?
  approvalStatus String   @default("PENDING")
  createdAt      DateTime @default(now())

  @@map("time_logs")
}

// ============================================================
// ROLE & PERMISSION MANAGEMENT (Company-defined roles)
// ============================================================

model CompanyRole {
  id          Int              @id @default(autoincrement())
  companyId   Int
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean          @default(true)
  employees   Employee[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([companyId, name])
  @@map("company_roles")
}

model RolePermission {
  id            Int         @id @default(autoincrement())
  companyRoleId Int
  companyRole   CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)
  module        String
  canRead       Boolean     @default(false)
  canWrite      Boolean     @default(false)
  canCreate     Boolean     @default(false)
  canDelete     Boolean     @default(false)
  canImport     Boolean     @default(false)
  canExport     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([companyRoleId, module])
  @@map("role_permissions")
}


// ============================================================
// SOCIAL FEED WIDGETS
// ============================================================

model Post {
  id          Int           @id @default(autoincrement())
  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  content     String        @db.Text
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  likes       PostLike[]
  comments    PostComment[]

  @@map("posts")
}

model PostLike {
  id          Int      @id @default(autoincrement())
  postId      Int
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([postId, employeeId])
  @@map("post_likes")
}

model PostComment {
  id          Int           @id @default(autoincrement())
  postId      Int
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  content     String        @db.Text
  parentId    Int?
  parent      PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PostComment[] @relation("CommentReplies")
  createdAt   DateTime      @default(now())
  likes       CommentLike[]

  @@map("post_comments")
}

model CommentLike {
  id          Int         @id @default(autoincrement())
  commentId   Int
  comment     PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  employeeId  Int
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([commentId, employeeId])
  @@map("comment_likes")
}
