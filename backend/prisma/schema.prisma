generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id               Int               @id @default(autoincrement())
  name             String
  email            String            @unique
  phone            String?
  subdomain        String            @unique
  industry         String?
  companySize      String?
  address          String?
  logoUrl          String?
  isEmailVerified  Boolean           @default(false)
  isActive         Boolean           @default(true)
  domainStatus     String            @default("APPROVED")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  emailDomain      String?
  announcements    Announcement[]
  applicants       Applicant[]
  assetCategories  AssetCategory[]
  assets           Asset[]
  attendancePolicy AttendancePolicy?
  clients          Client[]
  companyRoles     CompanyRole[]
  settings         CompanySetting?
  departments      Department[]
  designations     Designation[]
  holidays         Holiday[]
  invoices         Invoice[]
  jobPostings      JobPosting[]
  leavePolicies    LeavePolicy[]
  leaveTypes       LeaveType[]
  payrollPeriods   PayrollPeriod[]
  posts            Post[]
  projects         Project[]
  referrals        Referral[]
  shiftPolicies    ShiftPolicy[]
  subscription     Subscription?
  tasks            Task[]
  timeLogs         TimeLog[]
  users            User[]

  @@map("companies")
}

model SubscriptionPlan {
  id            Int            @id @default(autoincrement())
  name          String
  code          String         @unique
  description   String?        @db.Text
  priceMonthly  Float
  priceYearly   Float
  maxEmployees  Int            @default(10)
  maxStorageGb  Float          @default(5)
  features      Json?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id           Int                @id @default(autoincrement())
  companyId    Int                @unique
  planId       Int
  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  trialEndsAt  DateTime
  autoRenew    Boolean            @default(true)
  customFeatures Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  invoices     Invoice[]
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([planId], map: "subscriptions_planId_fkey")
  @@map("subscriptions")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  companyId      Int
  subscriptionId Int?
  invoiceNumber  String        @unique
  amount         Float
  currency       String        @default("INR")
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime
  paidAt         DateTime?
  paymentMethod  String?
  pdfUrl         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId], map: "invoices_companyId_fkey")
  @@index([subscriptionId], map: "invoices_subscriptionId_fkey")
  @@map("invoices")
}

model User {
  id                    Int                        @id @default(autoincrement())
  companyId             Int?
  name                  String
  email                 String                     @unique
  password              String
  role                  Role                       @default(EMPLOYEE)
  accountStatus         AccountStatus              @default(PENDING)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  regularizations       AttendanceRegularization[]
  emailVerifyTokens     EmailVerifyToken[]
  employee              Employee?
  inviteTokens          InviteToken[]
  notificationsReceived Notification[]             @relation("NotificationReceiver")
  notificationsSent     Notification[]             @relation("NotificationSender")
  passwordResetTokens   PasswordResetToken[]
  referrals             Referral[]                 @relation("ReferrerUser")
  TaskComment           TaskComment[]
  tasksCreated          Task[]                     @relation("TaskCreator")
  company               Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "users_companyId_fkey")
  @@map("users")
}

model Employee {
  id                           Int                 @id @default(autoincrement())
  userId                       Int                 @unique
  employeeCode                 String              @unique
  firstName                    String
  lastName                     String
  gender                       Gender?
  dateOfBirth                  DateTime?
  phone                        String?
  address                      String?
  profilePhotoUrl              String?
  dateOfJoining                DateTime?
  employmentType               EmploymentType      @default(FULL_TIME)
  departmentId                 Int?
  designationId                Int?
  reportingManagerId           Int?
  emergencyContactName         String?
  emergencyContactPhone        String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  city                         String?
  country                      String?
  postalCode                   String?
  state                        String?
  onboardingStatus             OnboardingStatus    @default(INVITED)
  shiftPolicyId                Int?
  aadhaarPath                  String?
  panPath                      String?
  resumePath                   String?
  rejectionReason              String?
  about                        String?             @db.Text
  education                    String?             @db.Text
  emergencyContactRelationship String?
  experience                   String?             @db.Text
  maritalStatus                String?
  nationality                  String?
  numberOfChildren             Int?
  passportExpiry               DateTime?
  passportNo                   String?
  religion                     String?
  spouseEmployed               String?
  spouseName                   String?
  companyRoleId                Int?
  announcementsCreated         Announcement[]      @relation("AnnouncementsCreated")
  assetAssignments             AssetAssignment[]
  attendanceRecords            AttendanceRecord[]
  bankDetails                  BankDetails?
  commentLikes                 CommentLike[]
  documents                    Document[]
  companyRole                  CompanyRole?        @relation(fields: [companyRoleId], references: [id])
  department                   Department?         @relation(fields: [departmentId], references: [id])
  designation                  Designation?        @relation(fields: [designationId], references: [id])
  reportingManager             Employee?           @relation("ManagerSubordinates", fields: [reportingManagerId], references: [id])
  subordinates                 Employee[]          @relation("ManagerSubordinates")
  shiftPolicy                  ShiftPolicy?        @relation(fields: [shiftPolicyId], references: [id])
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews                   Interview[]         @relation("Interviewer")
  inviteTokens                 InviteToken[]
  leaveBalances                LeaveBalance[]
  leaveRequests                LeaveRequest[]
  payrollEntries               PayrollEntry[]
  payslips                     Payslip[]
  goalsCreated                 PerformanceGoal[]   @relation("ManagerGoals")
  performanceGoals             PerformanceGoal[]   @relation("EmployeeGoals")
  performanceReviews           PerformanceReview[] @relation("EmployeeReviews")
  reviewsConducted             PerformanceReview[] @relation("ManagerReviews")
  postComments                 PostComment[]
  postLikes                    PostLike[]
  posts                        Post[]
  uploadedFiles                ProjectFile[]       @relation("FileUploader")
  projectMemberships           ProjectMember[]
  createdNotes                 ProjectNote[]       @relation("NoteCreator")
  companyManagedProjects       Project[]           @relation("ProjectCompanyManager")
  managedProjects              Project[]           @relation("ProjectManager")
  salaryStructure              SalaryStructure?
  tasksAssigned                Task[]              @relation("TaskAssignee")
  timeLogs                     TimeLog[]
  leavePolicies                LeavePolicy[]       @relation("EmployeeToLeavePolicy")

  @@index([companyRoleId], map: "employees_companyRoleId_fkey")
  @@index([departmentId], map: "employees_departmentId_fkey")
  @@index([designationId], map: "employees_designationId_fkey")
  @@index([reportingManagerId], map: "employees_reportingManagerId_fkey")
  @@index([shiftPolicyId], map: "employees_shiftPolicyId_fkey")
  @@map("employees")
}

model Department {
  id          Int          @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  headId      Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  jobPostings JobPosting[]

  @@unique([companyId, name])
  @@map("departments")
}

model Designation {
  id          Int        @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  createdAt   DateTime   @default(now())
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([companyId, name])
  @@map("designations")
}

model LeaveType {
  id               Int            @id @default(autoincrement())
  companyId        Int
  name             String
  totalDaysPerYear Decimal        @default(0.0) @db.Decimal(5, 1)
  isPaid           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  leaveBalances    LeaveBalance[]
  leavePolicies    LeavePolicy[]
  leaveRequests    LeaveRequest[]
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("leave_types")
}

model LeaveRequest {
  id           Int          @id @default(autoincrement())
  employeeId   Int
  leaveTypeId  Int
  startDate    DateTime
  endDate      DateTime
  totalDays    Decimal      @default(1.0) @db.Decimal(5, 1)
  reason       String?
  status       LeaveStatus  @default(PENDING)
  reviewedById Int?
  reviewedAt   DateTime?
  remarks      String?
  appliedAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  leaveSession LeaveSession @default(FULL_DAY)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId], map: "leave_requests_employeeId_fkey")
  @@index([leaveTypeId], map: "leave_requests_leaveTypeId_fkey")
  @@map("leave_requests")
}

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int
  totalDays   Decimal   @default(0.0) @db.Decimal(5, 1)
  usedDays    Decimal   @default(0.0) @db.Decimal(5, 1)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([leaveTypeId], map: "leave_balances_leaveTypeId_fkey")
  @@map("leave_balances")
}

model AttendancePolicy {
  id                     Int      @id @default(autoincrement())
  companyId              Int      @unique
  minimumHoursForHalfDay Decimal  @default(4.00) @db.Decimal(5, 2)
  minimumHoursForFullDay Decimal  @default(8.00) @db.Decimal(5, 2)
  allowWebPunch          Boolean  @default(true)
  requireGeofence        Boolean  @default(false)
  updatedAt              DateTime @updatedAt
  lateGracePeriod        Int      @default(15)
  autoCheckoutTime       String   @default("18:00")
  weekOffDays            String   @default("Saturday,Sunday")
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("attendance_policies")
}

model AttendanceRecord {
  id              Int                        @id @default(autoincrement())
  employeeId      Int
  date            DateTime                   @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  breakIn         DateTime?
  breakOut        DateTime?
  workingHours    Decimal?                   @db.Decimal(5, 2)
  status          AttendanceStatus           @default(PRESENT)
  notes           String?
  createdAt       DateTime                   @default(now())
  deviceType      String?                    @default("WEB")
  punchLocation   String?
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  regularizations AttendanceRegularization[]

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model AttendanceRegularization {
  id                 Int              @id @default(autoincrement())
  attendanceRecordId Int
  requestedCheckIn   DateTime?
  requestedCheckOut  DateTime?
  reason             String
  status             LeaveStatus      @default(PENDING)
  reviewedById       Int?
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  requestedBreakOut  DateTime?
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  reviewedBy         User?            @relation(fields: [reviewedById], references: [id])

  @@index([attendanceRecordId], map: "attendance_regularizations_attendanceRecordId_fkey")
  @@index([reviewedById], map: "attendance_regularizations_reviewedById_fkey")
  @@map("attendance_regularizations")
}

model SalaryStructure {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @unique
  basic            Decimal  @default(0.00) @db.Decimal(12, 2)
  hra              Decimal  @default(0.00) @db.Decimal(12, 2)
  conveyance       Decimal  @default(0.00) @db.Decimal(12, 2)
  medicalAllowance Decimal  @default(0.00) @db.Decimal(12, 2)
  specialAllowance Decimal  @default(0.00) @db.Decimal(12, 2)
  pfDeduction      Decimal  @default(0.00) @db.Decimal(12, 2)
  professionalTax  Decimal  @default(0.00) @db.Decimal(12, 2)
  otherDeductions  Decimal  @default(0.00) @db.Decimal(12, 2)
  grossSalary      Decimal  @default(0.00) @db.Decimal(12, 2)
  netSalary        Decimal  @default(0.00) @db.Decimal(12, 2)
  effectiveFrom    DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bonus            Decimal  @default(0.00) @db.Decimal(12, 2)
  pfEmployer       Decimal  @default(0.00) @db.Decimal(12, 2)
  tdsDeduction     Decimal  @default(0.00) @db.Decimal(12, 2)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model Payslip {
  id              Int           @id @default(autoincrement())
  employeeId      Int
  month           Int
  year            Int
  basic           Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAllowances Decimal       @default(0.00) @db.Decimal(12, 2)
  totalDeductions Decimal       @default(0.00) @db.Decimal(12, 2)
  netPay          Decimal       @db.Decimal(12, 2)
  filePath        String?
  generatedAt     DateTime      @default(now())
  payrollEntryId  Int?          @unique
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollEntry    PayrollEntry? @relation(fields: [payrollEntryId], references: [id])

  @@unique([employeeId, month, year])
  @@map("payslips")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  companyId   Int
  title       String
  holidayDate DateTime @db.Date
  description String?
  isNational  Boolean  @default(false)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "holidays_companyId_fkey")
  @@map("holidays")
}

model AssetCategory {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets    Asset[]

  @@index([companyId], map: "asset_categories_companyId_fkey")
  @@map("asset_categories")
}

model Asset {
  id           Int               @id @default(autoincrement())
  companyId    Int
  categoryId   Int?
  name         String
  assetCode    String            @unique
  status       AssetStatus       @default(AVAILABLE)
  purchaseDate DateTime?
  description  String?
  createdAt    DateTime          @default(now())
  assignments  AssetAssignment[]
  category     AssetCategory?    @relation(fields: [categoryId], references: [id])
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "assets_categoryId_fkey")
  @@index([companyId], map: "assets_companyId_fkey")
  @@map("assets")
}

model AssetAssignment {
  id         Int       @id @default(autoincrement())
  assetId    Int
  employeeId Int
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([assetId], map: "asset_assignments_assetId_fkey")
  @@index([employeeId], map: "asset_assignments_employeeId_fkey")
  @@map("asset_assignments")
}

model Document {
  id         Int            @id @default(autoincrement())
  employeeId Int
  name       String
  fileUrl    String
  fileType   String?
  status     DocumentStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime       @default(now())
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "documents_employeeId_fkey")
  @@map("documents")
}

model PerformanceGoal {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  createdById Int
  title       String
  description String?
  targetDate  DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdBy   Employee  @relation("ManagerGoals", fields: [createdById], references: [id], onDelete: Cascade)
  employee    Employee  @relation("EmployeeGoals", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([createdById], map: "performance_goals_createdById_fkey")
  @@index([employeeId], map: "performance_goals_employeeId_fkey")
  @@map("performance_goals")
}

model PerformanceReview {
  id         Int      @id @default(autoincrement())
  employeeId Int
  reviewerId Int
  rating     Int
  feedback   String?
  reviewDate DateTime @default(now())
  employee   Employee @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer   Employee @relation("ManagerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "performance_reviews_employeeId_fkey")
  @@index([reviewerId], map: "performance_reviews_reviewerId_fkey")
  @@map("performance_reviews")
}

model Notification {
  id         Int              @id @default(autoincrement())
  receiverId Int
  senderId   Int?
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  receiver   User             @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?            @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([receiverId], map: "notifications_receiverId_fkey")
  @@index([senderId], map: "notifications_senderId_fkey")
  @@map("notifications")
}

model Announcement {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  title               String
  content             String    @db.Text
  createdAt           DateTime  @default(now())
  createdByEmployeeId Int?
  expiresAt           DateTime?
  imageUrl            String?
  publishedAt         DateTime  @default(now())
  targetDepartmentId  Int?
  targetType          String    @default("ALL")
  updatedAt           DateTime  @default(now()) @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy           Employee? @relation("AnnouncementsCreated", fields: [createdByEmployeeId], references: [id])

  @@index([companyId], map: "announcements_companyId_fkey")
  @@index([createdByEmployeeId], map: "announcements_createdByEmployeeId_fkey")
  @@map("announcements")
}

model CompanySetting {
  id                   Int     @id @default(autoincrement())
  companyId            Int     @unique
  workingDays          String  @default("Mon,Tue,Wed,Thu,Fri")
  officeStartTime      String  @default("09:00")
  officeEndTime        String  @default("18:00")
  timezone             String  @default("Asia/Kolkata")
  currency             String  @default("INR")
  payrollCycleStartDay Int     @default(1)
  company              Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model InviteToken {
  id         Int      @id @default(autoincrement())
  employeeId Int
  userId     Int?
  token      String   @unique
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([employeeId], map: "invite_tokens_employeeId_fkey")
  @@index([userId], map: "invite_tokens_userId_fkey")
  @@map("invite_tokens")
}

model EmailVerifyToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "email_verify_tokens_userId_fkey")
  @@map("email_verify_tokens")
}

model BankDetails {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @unique
  accountName   String
  accountNumber String
  bankName      String
  ifscCode      String
  branchName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("bank_details")
}

model ShiftPolicy {
  id          Int        @id @default(autoincrement())
  companyId   Int
  name        String
  startTime   String
  endTime     String
  gracePeriod Int        @default(15)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "shift_policies_companyId_fkey")
  @@map("shift_policies")
}

model LeavePolicy {
  id          Int        @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  days        Decimal    @db.Decimal(5, 1)
  leaveTypeId Int
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveType   LeaveType  @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  employees   Employee[] @relation("EmployeeToLeavePolicy")

  @@unique([companyId, leaveTypeId, name])
  @@index([leaveTypeId], map: "leave_policies_leaveTypeId_fkey")
  @@map("leave_policies")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_userId_fkey")
  @@map("password_reset_tokens")
}

model Client {
  id            Int       @id @default(autoincrement())
  companyId     Int
  companyName   String
  contactPerson String?
  email         String
  phone         String?
  address       String?
  website       String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects      Project[]

  @@index([companyId], map: "clients_companyId_fkey")
  @@map("clients")
}

model Project {
  id               Int                @id @default(autoincrement())
  companyId        Int
  projectCode      String             @unique
  name             String
  description      String?            @db.Text
  clientId         Int?
  projectManagerId Int?
  startDate        DateTime
  endDate          DateTime
  budget           Float?
  actualCost       Float              @default(0)
  priority         ProjectPriority    @default(MEDIUM)
  status           ProjectStatus      @default(ACTIVE)
  healthStatus     ProjectHealth      @default(GOOD)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  attachmentUrl    String?
  logoUrl          String?
  managerId        Int?
  files            ProjectFile[]
  members          ProjectMember[]
  milestones       ProjectMilestone[]
  notes            ProjectNote[]
  client           Client?            @relation(fields: [clientId], references: [id])
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager          Employee?          @relation("ProjectCompanyManager", fields: [managerId], references: [id])
  projectManager   Employee?          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tasks            Task[]
  timeLogs         TimeLog[]

  @@index([clientId], map: "projects_clientId_fkey")
  @@index([companyId], map: "projects_companyId_fkey")
  @@index([managerId], map: "projects_managerId_fkey")
  @@index([projectManagerId], map: "projects_projectManagerId_fkey")
  @@map("projects")
}

model ProjectMember {
  id                   Int      @id @default(autoincrement())
  projectId            Int
  employeeId           Int
  role                 String?
  allocationPercentage Float    @default(100)
  createdAt            DateTime @default(now())
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId], map: "project_members_employeeId_fkey")
  @@map("project_members")
}

model ProjectMilestone {
  id                   Int      @id @default(autoincrement())
  projectId            Int
  name                 String
  dueDate              DateTime
  completionPercentage Float    @default(0)
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  description          String?  @db.Text
  startDate            DateTime @default(now())
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                Task[]

  @@index([projectId], map: "project_milestones_projectId_fkey")
  @@map("project_milestones")
}

model ProjectNote {
  id          Int       @id @default(autoincrement())
  projectId   Int
  title       String
  content     String    @db.Text
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   Employee? @relation("NoteCreator", fields: [createdById], references: [id])
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdById], map: "project_notes_createdById_fkey")
  @@index([projectId], map: "project_notes_projectId_fkey")
  @@map("project_notes")
}

model ProjectFile {
  id           Int       @id @default(autoincrement())
  projectId    Int
  name         String
  url          String
  fileType     String    @default("file")
  mimeType     String?
  sizeBytes    Int?
  uploadedById Int?
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   Employee? @relation("FileUploader", fields: [uploadedById], references: [id])

  @@index([projectId], map: "project_files_projectId_fkey")
  @@index([uploadedById], map: "project_files_uploadedById_fkey")
  @@map("project_files")
}

model Task {
  id              Int               @id @default(autoincrement())
  companyId       Int
  taskCode        String            @unique
  title           String
  description     String?           @db.Text
  projectId       Int
  milestoneId     Int?
  assignedToId    Int?
  createdById     Int?
  priority        ProjectPriority   @default(MEDIUM)
  status          TaskStatus        @default(TODO)
  startDate       DateTime?
  dueDate         DateTime?
  estimatedHours  Float             @default(0)
  actualHours     Float             @default(0)
  dependsOnTaskId Int?
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  subTasks        SubTask[]
  comments        TaskComment[]
  assignedTo      Employee?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User?             @relation("TaskCreator", fields: [createdById], references: [id])
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id])
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeLogs        TimeLog[]

  @@index([assignedToId], map: "tasks_assignedToId_fkey")
  @@index([companyId], map: "tasks_companyId_fkey")
  @@index([createdById], map: "tasks_createdById_fkey")
  @@index([milestoneId], map: "tasks_milestoneId_fkey")
  @@index([projectId], map: "tasks_projectId_fkey")
  @@map("tasks")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  text      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "task_comments_taskId_fkey")
  @@index([userId], map: "task_comments_userId_fkey")
  @@map("task_comments")
}

model SubTask {
  id          Int      @id @default(autoincrement())
  taskId      Int
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "sub_tasks_taskId_fkey")
  @@map("sub_tasks")
}

model TimeLog {
  id             Int      @id @default(autoincrement())
  companyId      Int
  employeeId     Int
  projectId      Int
  taskId         Int?
  logDate        DateTime
  hoursSpent     Float
  billableHours  Float    @default(0)
  description    String?
  approvalStatus String   @default("PENDING")
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task           Task?    @relation(fields: [taskId], references: [id])

  @@index([companyId], map: "time_logs_companyId_fkey")
  @@index([employeeId], map: "time_logs_employeeId_fkey")
  @@index([projectId], map: "time_logs_projectId_fkey")
  @@index([taskId], map: "time_logs_taskId_fkey")
  @@map("time_logs")
}

model CompanyRole {
  id          Int              @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@map("company_roles")
}

model RolePermission {
  id            Int         @id @default(autoincrement())
  companyRoleId Int
  module        String
  canRead       Boolean     @default(false)
  canWrite      Boolean     @default(false)
  canCreate     Boolean     @default(false)
  canDelete     Boolean     @default(false)
  canImport     Boolean     @default(false)
  canExport     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  companyRole   CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)

  @@unique([companyRoleId, module])
  @@map("role_permissions")
}

model Post {
  id         Int           @id @default(autoincrement())
  companyId  Int
  content    String        @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  employeeId Int?
  image      String?
  comments   PostComment[]
  likes      PostLike[]
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee   Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "posts_companyId_fkey")
  @@index([employeeId], map: "posts_employeeId_fkey")
  @@map("posts")
}

model PostLike {
  id         Int      @id @default(autoincrement())
  postId     Int
  employeeId Int
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, employeeId])
  @@index([employeeId], map: "post_likes_employeeId_fkey")
  @@map("post_likes")
}

model PostComment {
  id         Int           @id @default(autoincrement())
  postId     Int
  content    String        @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  employeeId Int?
  parentId   Int?
  likes      CommentLike[]
  employee   Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  parent     PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    PostComment[] @relation("CommentReplies")
  post       Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "post_comments_employeeId_fkey")
  @@index([parentId], map: "post_comments_parentId_fkey")
  @@index([postId], map: "post_comments_postId_fkey")
  @@map("post_comments")
}

model CommentLike {
  id         Int         @id @default(autoincrement())
  commentId  Int
  employeeId Int
  createdAt  DateTime    @default(now())
  comment    PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([commentId, employeeId])
  @@index([employeeId], map: "comment_likes_employeeId_fkey")
  @@map("comment_likes")
}

model PayrollPeriod {
  id              Int                 @id @default(autoincrement())
  companyId       Int
  periodStart     DateTime            @db.Date
  periodEnd       DateTime            @db.Date
  label           String
  totalDays       Int
  weekoffDays     Int                 @default(0)
  holidayDays     Int                 @default(0)
  workingDays     Int                 @default(0)
  status          PayrollPeriodStatus @default(DRAFT)
  totalGross      Decimal             @default(0.00) @db.Decimal(14, 2)
  totalDeductions Decimal             @default(0.00) @db.Decimal(14, 2)
  totalNetPay     Decimal             @default(0.00) @db.Decimal(14, 2)
  approvedAt      DateTime?
  approvedById    Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  entries         PayrollEntry[]
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodStart])
  @@map("payroll_periods")
}

model PayrollEntry {
  id               Int                @id @default(autoincrement())
  payrollPeriodId  Int
  employeeId       Int
  basic            Decimal            @default(0.00) @db.Decimal(12, 2)
  hra              Decimal            @default(0.00) @db.Decimal(12, 2)
  conveyance       Decimal            @default(0.00) @db.Decimal(12, 2)
  medicalAllowance Decimal            @default(0.00) @db.Decimal(12, 2)
  specialAllowance Decimal            @default(0.00) @db.Decimal(12, 2)
  bonus            Decimal            @default(0.00) @db.Decimal(12, 2)
  grossEarnings    Decimal            @default(0.00) @db.Decimal(12, 2)
  totalDays        Int                @default(0)
  protectedDays    Int                @default(0)
  paidLeaveDays    Decimal            @default(0.00) @db.Decimal(5, 2)
  presentDays      Decimal            @default(0.00) @db.Decimal(5, 2)
  halfDays         Decimal            @default(0.00) @db.Decimal(5, 2)
  lopDays          Decimal            @default(0.00) @db.Decimal(5, 2)
  lopDeduction     Decimal            @default(0.00) @db.Decimal(12, 2)
  pfDeduction      Decimal            @default(0.00) @db.Decimal(12, 2)
  professionalTax  Decimal            @default(0.00) @db.Decimal(12, 2)
  tdsDeduction     Decimal            @default(0.00) @db.Decimal(12, 2)
  otherDeductions  Decimal            @default(0.00) @db.Decimal(12, 2)
  totalDeductions  Decimal            @default(0.00) @db.Decimal(12, 2)
  netPay           Decimal            @default(0.00) @db.Decimal(12, 2)
  hrRemarks        String?
  status           PayrollEntryStatus @default(DRAFT)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollPeriod    PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  payslip          Payslip?

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId], map: "payroll_entries_employeeId_fkey")
  @@map("payroll_entries")
}

model JobPosting {
  id              Int              @id @default(autoincrement())
  companyId       Int
  jobCode         String           @unique
  title           String
  departmentId    Int?
  employmentType  EmploymentType   @default(FULL_TIME)
  experienceLevel String?
  location        String?
  vacancies       Int              @default(1)
  minSalary       Float?
  maxSalary       Float?
  status          JobPostingStatus @default(OPEN)
  description     String?          @db.Text
  requirements    String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bannerUrl       String?          @db.Text
  applicants      Applicant[]
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId], references: [id])
  referrals       Referral[]

  @@index([companyId], map: "job_postings_companyId_fkey")
  @@index([departmentId], map: "job_postings_departmentId_fkey")
  @@map("job_postings")
}

model Applicant {
  id           Int            @id @default(autoincrement())
  companyId    Int
  jobPostingId Int
  firstName    String
  lastName     String
  email        String
  phone        String?
  resumeUrl    String?
  stage        ApplicantStage @default(APPLIED)
  rating       Int            @default(0)
  notes        String?        @db.Text
  appliedAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPosting   JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews   Interview[]

  @@index([companyId], map: "applicants_companyId_fkey")
  @@index([jobPostingId], map: "applicants_jobPostingId_fkey")
  @@map("applicants")
}

model Interview {
  id              Int             @id @default(autoincrement())
  applicantId     Int
  interviewerId   Int?
  scheduledAt     DateTime
  locationOrLink  String?
  status          InterviewStatus @default(SCHEDULED)
  scorecardRating Int?
  feedbackNotes   String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  applicant       Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  interviewer     Employee?       @relation("Interviewer", fields: [interviewerId], references: [id])

  @@index([applicantId], map: "interviews_applicantId_fkey")
  @@index([interviewerId], map: "interviews_interviewerId_fkey")
  @@map("interviews")
}

model Referral {
  id             Int            @id @default(autoincrement())
  companyId      Int
  referrerId     Int
  jobPostingId   Int?
  candidateName  String
  candidateEmail String
  candidatePhone String?
  relationship   String?
  resumeUrl      String?
  notes          String?        @db.Text
  status         ReferralStatus @default(PENDING)
  rewardAmount   Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobPosting     JobPosting?    @relation(fields: [jobPostingId], references: [id])
  referrer       User           @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "referrals_companyId_fkey")
  @@index([jobPostingId], map: "referrals_jobPostingId_fkey")
  @@index([referrerId], map: "referrals_referrerId_fkey")
  @@map("referrals")
}

